{
  "name": "aicompany",
  "version": "0.1.0-p6",
  "private": true,
  "description": "AICompany - protocol-first multi-agent company engine (zero runtime dependencies)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "test:p1": "node --test tests/p1.test.js",
    "test:p2": "node --test tests/p2.test.js",
    "test:p5": "node --test tests/p5.test.js",
    "doctor": "node src/cli.js doctor",
    "doctor:prod": "node src/cli.js doctor config/company.prod.yaml",
    "schemas": "node src/cli.js schemas",
    "validate": "node src/cli.js validate",
    "start": "node src/server.js",
    "start:prod": "node src/runner.js --profile prod",
    "start:demo": "node src/runner.js --profile demo",
    "bridge": "node scripts/bridge.js",
    "start:daemon": "node scripts/daemon.js",
    "task": "node scripts/new-task.js",
    "soak": "node scripts/soak.js",
    "soak:real": "node scripts/soak.js --hours 72 --mode real --interval 60",
    "prod-watch": "node scripts/prod-watch.js",
    "prod-watch:72h": "node scripts/prod-watch.js --hours 72 --interval 60",
    "win:install": "powershell -ExecutionPolicy Bypass -File scripts/win/install.ps1",
    "win:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/win/install.ps1 -Uninstall",
    "win:start": "powershell -ExecutionPolicy Bypass -File scripts/win/start.ps1",
    "win:stop": "powershell -ExecutionPolicy Bypass -File scripts/win/stop.ps1",
    "win:status": "powershell -ExecutionPolicy Bypass -File scripts/win/status.ps1",
    "win:tray": "powershell -ExecutionPolicy Bypass -WindowStyle Hidden -File scripts/win/tray.ps1",
    "start:hidden": "node src/runner.js",
    "seat": "node scripts/seat.js"
  },
  "dependencies": {},
  "devDependencies": {}
}
