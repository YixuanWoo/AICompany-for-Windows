{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aicompany.company-config/v1",
  "title": "CompanyConfig",
  "description": "用户填的公司配置。引擎零产品名：agents 只认能力标签与通用 adapter type（任务书 §6B.4 / §6C.7）。",
  "type": "object",
  "required": [
    "version",
    "agents",
    "clients",
    "notifier"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "holders": {
      "description": "担任者池：每一个都是一个真实的 agent / 程序。name 必须是 agent 的名字（一看就知道谁干）。",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "adapter"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string"
          },
          "quotaDaily": {
            "type": "integer",
            "minimum": 0
          },
          "adapter": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "process",
                  "http",
                  "cli-acp",
                  "gui-template",
                  "polling",
                  "webhook-exec",
                  "seat"
                ]
              },
              "config": {
                "type": "object"
              }
            }
          },
          "dispatch": {
            "type": "string",
            "enum": [
              "push",
              "pull"
            ],
            "description": "派活方式：push=控制面直调 adapter（默认）；pull=卡留队列，由席位自己来领（人叫才醒的交互式 agent 用这个）"
          }
        }
      }
    },
    "posts": {
      "description": "岗位（席位）：title 是岗位名称，heldBy 指向 holders 里的 id。同一个 holder 可担任多个岗位。",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "heldBy",
          "isCEO"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "heldBy": {
            "type": "string"
          },
          "adapterConfig": {
            "description": "覆盖担任者的 adapter 参数（例：同一 agent 在总经理岗用 mode=ceo）。",
            "type": "object"
          },
          "isCEO": {
            "type": "boolean"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "enum": [
                "plan",
                "delegate",
                "review",
                "execute",
                "escalate",
                "readOnly"
              ]
            }
          },
          "status": {
            "enum": [
              "active",
              "setup",
              "paused",
              "pending_approval",
              "error"
            ]
          },
          "quotaDaily": {
            "type": "integer",
            "minimum": 0
          },
          "maxDifficulty": {
            "enum": [
              "easy",
              "normal",
              "hard"
            ]
          },
          "reportsTo": {
            "type": [
              "string",
              "null"
            ]
          },
          "escalationTo": {
            "type": [
              "string",
              "null"
            ]
          },
          "dispatch": {
            "type": "string",
            "enum": [
              "push",
              "pull"
            ],
            "description": "派活方式：push=控制面直调 adapter（默认）；pull=卡留队列，由席位自己来领（人叫才醒的交互式 agent 用这个）"
          },
          "duties": {
            "type": "string",
            "description": "岗位职责一句话，写进提示词"
          },
          "boundaries": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "这个岗位不许做什么"
          },
          "mayDelegateTo": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "可以往下派的岗位（说明用；真正的闸是汇报子树）"
          }
        }
      }
    },
    "workRoot": {
      "type": "string"
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "warnRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stopRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "periodHours": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "boolean"
        },
        "hiringBudget": {
          "type": "boolean"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remindAfterHours": {
          "type": "integer",
          "minimum": 1
        },
        "maxPendingHours": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "projects": {
      "type": "object",
      "description": "P7 项目层：配了项目就「下单必选项目」。规范与记忆都落在 <workRoot>/projects/<id>/ 下，项目文件夹只出交付物。",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "archiveDir": {
            "type": [
              "string",
              "null"
            ]
          },
          "memoryLimit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50
          }
        }
      }
    },
    "company": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        }
      }
    },
    "interaction": {
      "type": "object",
      "properties": {
        "defaultMode": {
          "enum": [
            "delegate",
            "direct",
            "cowork",
            "meeting"
          ]
        },
        "defaultTarget": {
          "type": "string"
        },
        "allowDirectTo": {
          "type": "array",
          "items": {
            "enum": [
              "plan",
              "delegate",
              "review",
              "execute",
              "escalate",
              "readOnly"
            ]
          }
        },
        "autoAssign": {
          "type": "boolean"
        },
        "modes": {
          "type": "object"
        },
        "meeting": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "defaultStyle": {
              "enum": [
                "readonly",
                "rollCall",
                "full"
              ]
            },
            "fullRequiresConfirm": {
              "type": "boolean"
            }
          }
        },
        "thread": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttlDays": {
              "type": "integer",
              "minimum": 1
            },
            "promoteRequiresExplicit": {
              "type": "boolean"
            }
          }
        },
        "ceoSession": {
          "type": "object",
          "additionalProperties": false,
          "description": "总经理（按量计费席位）的会话复用：共用会话才能命中缓存省钱。",
          "properties": {
            "reuse": {
              "type": "boolean",
              "description": "false = 每轮新开会话（排查用）；默认 true"
            },
            "warnTurns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "description": "到这个轮次提醒董事会换新"
            },
            "maxTurns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000,
              "description": "到这个轮次自动换新"
            }
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "isCEO",
          "capabilities",
          "status",
          "adapter"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "displayName": {
            "type": "string"
          },
          "post": {
            "description": "岗位名（席位的名字，如「总经理」「执行」）。与 holder 分开：岗位不随换人改变。",
            "type": "string"
          },
          "holder": {
            "description": "由谁担任这个岗位。写字符串即人名/agent 名；也可写 {name, kind}。",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ]
              }
            ]
          },
          "holderKind": {
            "description": "担任者类型：external-agent（8080 上的 agent）/ gui-app（桌面应用）/ process（本地脚本）。",
            "type": "string"
          },
          "isCEO": {
            "type": "boolean"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "enum": [
                "plan",
                "delegate",
                "review",
                "execute",
                "escalate",
                "readOnly"
              ]
            }
          },
          "status": {
            "enum": [
              "active",
              "setup",
              "paused",
              "pending_approval",
              "error"
            ]
          },
          "quotaDaily": {
            "type": "integer",
            "minimum": 0
          },
          "maxDifficulty": {
            "description": "这个岗位最多能接的难度。不写 = 不设限（hard）。",
            "enum": [
              "easy",
              "normal",
              "hard"
            ]
          },
          "reportsTo": {
            "type": [
              "string",
              "null"
            ]
          },
          "escalationTo": {
            "type": [
              "string",
              "null"
            ]
          },
          "adapter": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "process",
                  "http",
                  "cli-acp",
                  "gui-template",
                  "polling",
                  "webhook-exec",
                  "seat"
                ]
              },
              "config": {
                "type": "object"
              }
            }
          },
          "dispatch": {
            "type": "string",
            "enum": [
              "push",
              "pull"
            ],
            "description": "派活方式：push=控制面直调 adapter（默认）；pull=卡留队列，由席位自己来领（人叫才醒的交互式 agent 用这个）"
          }
        }
      }
    },
    "clients": {
      "type": "array",
      "items": {
        "enum": [
          "web",
          "im",
          "cli",
          "noop"
        ]
      }
    },
    "notifier": {
      "type": "array",
      "items": {
        "enum": [
          "web",
          "im",
          "webhook",
          "stdout",
          "noop",
          "desktop"
        ]
      }
    },
    "defaults": {
      "type": "object"
    },
    "runPolicy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Run Policy 第 4 条：并发上限与冷却（P5 起可配、可调、可观测）",
      "properties": {
        "maxConcurrent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "cooldownSec": {
          "type": "integer",
          "minimum": 0
        },
        "maxRunHours": {
          "type": "number",
          "minimum": 0.1
        },
        "staleEventMinutes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "repos": {
      "type": "object",
      "description": "仓库台账：代码在哪、往哪推、谁审。与项目解耦，两边都可以缺省。",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "displayName": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "remote": {
            "type": [
              "string",
              "null"
            ]
          },
          "branch": {
            "type": "string"
          },
          "reviewer": {
            "type": [
              "string",
              "null"
            ]
          },
          "allowPush": {
            "type": "boolean"
          },
          "project": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "defaultReviewer": {
          "type": "string"
        },
        "defaultHandoff": {
          "enum": [
            "ceo",
            "review",
            "land"
          ]
        },
        "requireRepoForManagedCode": {
          "type": "boolean"
        },
        "codeExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}