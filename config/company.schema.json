{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aicompany.company-config/v1",
  "title": "CompanyConfig",
  "description": "用户填的公司配置。引擎零产品名：agents 只认能力标签与通用 adapter type（任务书 §6B.4 / §6C.7）。",
  "type": "object",
  "required": [
    "version",
    "agents",
    "clients",
    "notifier"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "holders": {
      "description": "担任者池：每一个都是一个真实的 agent / 程序。name 必须是 agent 的名字（一看就知道谁干）。",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "adapter"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string"
          },
          "quotaDaily": {
            "type": "integer",
            "minimum": 0
          },
          "adapter": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "process",
                  "http",
                  "cli-acp",
                  "gui-template",
                  "polling",
                  "webhook-exec",
                  "seat"
                ]
              },
              "config": {
                "type": "object"
              }
            }
          },
          "dispatch": {
            "type": "string",
            "enum": [
              "push",
              "pull"
            ],
            "description": "派活方式：push=控制面直调 adapter（默认）；pull=卡留队列，由席位自己来领（人叫才醒的交互式 agent 用这个）"
          }
        }
      }
    },
    "posts": {
      "description": "岗位（席位）：title 是岗位名称，heldBy 指向 holders 里的 id。同一个 holder 可担任多个岗位。",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "heldBy",
          "isCEO"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "heldBy": {
            "type": "string"
          },
          "adapterConfig": {
            "description": "覆盖担任者的 adapter 参数（例：同一 agent 在总经理岗用 mode=ceo）。",
            "type": "object"
          },
          "isCEO": {
            "type": "boolean"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "enum": [
                "plan",
                "delegate",
                "review",
                "execute",
                "escalate",
                "readOnly"
              ]
            }
          },
          "status": {
            "enum": [
              "active",
              "setup",
              "paused",
              "pending_approval",
              "error"
            ]
          },
          "quotaDaily": {
            "type": "integer",
            "minimum": 0
          },
          "maxDifficulty": {
            "enum": [
              "easy",
              "normal",
              "hard"
            ]
          },
          "reportsTo": {
            "type": [
              "string",
              "null"
            ]
          },
          "escalationTo": {
            "type": [
              "string",
              "null"
            ]
          },
          "dispatch": {
            "type": "string",
            "enum": [
              "push",
              "pull"
            ],
            "description": "派活方式：push=控制面直调 adapter（默认）；pull=卡留队列，由席位自己来领（人叫才醒的交互式 agent 用这个）"
          },
          "duties": {
            "type": "string",
            "description": "岗位职责一句话，写进提示词"
          },
          "boundaries": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "这个岗位不许做什么"
          },
          "mayDelegateTo": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "可以往下派的岗位（说明用；真正的闸是汇报子树）"
          }
        }
      }
    },
    "workRoot": {
      "type": "string"
    },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "description": "bridge / seat 拉模式总开关（2026-11-18 停用）。enabled=false 时 /api/bridge/* 一律 503，代码保留不删。",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "true = 允许 bridge / seat 客户端来领活；false = 一律拒绝，任务只走控制面直派"
        }
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "warnRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stopRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "periodHours": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "boolean"
        },
        "hiringBudget": {
          "type": "boolean"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remindAfterHours": {
          "type": "integer",
          "minimum": 1
        },
        "maxPendingHours": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "projects": {
      "type": "object",
      "description": "P7 项目层：配了项目就「下单必选项目」。规范与记忆都落在 <workRoot>/projects/<id>/ 下，项目文件夹只出交付物。",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "archiveDir": {
            "type": [
              "string",
              "null"
            ]
          },
          "memoryLimit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50
          }
        }
      }
    },
    "company": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        }
      }
    },
    "interaction": {
      "type": "object",
      "properties": {
        "defaultMode": {
          "enum": [
            "delegate",
            "direct",
            "cowork",
            "meeting"
          ]
        },
        "defaultTarget": {
          "type": "string"
        },
        "allowDirectTo": {
          "type": "array",
          "items": {
            "enum": [
              "plan",
              "delegate",
              "review",
              "execute",
              "escalate",
              "readOnly"
            ]
          }
        },
        "autoAssign": {
          "type": "boolean"
        },
        "modes": {
          "type": "object"
        },
        "meeting": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "defaultStyle": {
              "enum": [
                "readonly",
                "rollCall",
                "full"
              ]
            },
            "fullRequiresConfirm": {
              "type": "boolean"
            }
          }
        },
        "thread": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttlDays": {
              "type": "integer",
              "minimum": 1
            },
            "promoteRequiresExplicit": {
              "type": "boolean"
            }
          }
        },
        "ceoSession": {
          "type": "object",
          "additionalProperties": false,
          "description": "总经理（按量计费席位）的会话复用：共用会话才能命中缓存省钱。",
          "properties": {
            "reuse": {
              "type": "boolean",
              "description": "false = 每轮新开会话（排查用）；默认 true"
            },
            "warnTurns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "description": "到这个轮次提醒董事会换新"
            },
            "maxTurns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000,
              "description": "到这个轮次自动换新"
            }
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "isCEO",
          "capabilities",
          "status",
          "adapter"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "displayName": {
            "type": "string"
          },
          "post": {
            "description": "岗位名（席位的名字，如「总经理」「执行」）。与 holder 分开：岗位不随换人改变。",
            "type": "string"
          },
          "holder": {
            "description": "由谁担任这个岗位。写字符串即人名/agent 名；也可写 {name, kind}。",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ]
              }
            ]
          },
          "holderKind": {
            "description": "担任者类型：external-agent（8080 上的 agent）/ gui-app（桌面应用）/ process（本地脚本）。",
            "type": "string"
          },
          "isCEO": {
            "type": "boolean"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "enum": [
                "plan",
                "delegate",
                "review",
                "execute",
                "escalate",
                "readOnly"
              ]
            }
          },
          "status": {
            "enum": [
              "active",
              "setup",
              "paused",
              "pending_approval",
              "error"
            ]
          },
          "quotaDaily": {
            "type": "integer",
            "minimum": 0
          },
          "maxDifficulty": {
            "description": "这个岗位最多能接的难度。不写 = 不设限（hard）。",
            "enum": [
              "easy",
              "normal",
              "hard"
            ]
          },
          "reportsTo": {
            "type": [
              "string",
              "null"
            ]
          },
          "escalationTo": {
            "type": [
              "string",
              "null"
            ]
          },
          "adapter": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "process",
                  "http",
                  "cli-acp",
                  "gui-template",
                  "polling",
                  "webhook-exec",
                  "seat"
                ]
              },
              "config": {
                "type": "object"
              }
            }
          },
          "dispatch": {
            "type": "string",
            "enum": [
              "push",
              "pull"
            ],
            "description": "派活方式：push=控制面直调 adapter（默认）；pull=卡留队列，由席位自己来领（人叫才醒的交互式 agent 用这个）"
          }
        }
      }
    },
    "clients": {
      "type": "array",
      "items": {
        "enum": [
          "web",
          "im",
          "cli",
          "noop"
        ]
      }
    },
    "notifier": {
      "type": "array",
      "items": {
        "enum": [
          "web",
          "im",
          "webhook",
          "stdout",
          "noop",
          "desktop"
        ]
      }
    },
    "defaults": {
      "type": "object"
    },
    "runPolicy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Run Policy 第 4 条：并发上限与冷却（P5 起可配、可调、可观测）",
      "properties": {
        "maxConcurrent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "cooldownSec": {
          "type": "integer",
          "minimum": 0
        },
        "maxRunHours": {
          "type": "number",
          "minimum": 0.1
        },
        "staleEventMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "escalateToBoss": {
          "type": "boolean",
          "description": "卡走不下去时先交给汇报线上的上级（agent）处置，只有汇报线到顶才出人审批单（2026-11-17 稳定性加固）"
        },
        "stuckMinutes": {
          "type": "integer",
          "minimum": 0,
          "description": "卡在同一状态停留超过这么多分钟就触发心跳看门狗（补投 / 向上汇报）；0 = 关"
        },
        "parentWaitMinutes": {
          "type": "integer",
          "minimum": 0,
          "description": "父卡派出子卡后仍占着会话干等，超过这么多分钟由引擎中断该 run 并置为等子卡；0 = 关"
        },
        "seatReviewFallbackMinutes": {
          "type": "integer",
          "minimum": 0,
          "description": "验收该由中层席位审时，等它这么多分钟仍未审才转总经理兜底；0 = 不等待（补审一律归 CEO）"
        },
        "reviewEscalateMinutes": {
          "type": "integer",
          "minimum": 0,
          "description": "验收久悬的第二道兜底：让路（人在用电脑）不计补审额度后，超过这么多分钟仍停在待验收就报一次董事会（自动补审继续）；0 = 关"
        },
        "evidenceEnabled": {
          "type": "boolean",
          "description": "证据层总开关：开启后引擎按 dispatch/ack/活动/交付四级证据判断 run 是否真在干活（2026-11-18）"
        },
        "ackTimeoutSec": {
          "type": "integer",
          "minimum": 1,
          "description": "派出去这么多秒仍未观测到系统级启动回执（dispatch.json）→ 判定进程没起来，中断并重派"
        },
        "idleTimeoutSec": {
          "type": "integer",
          "minimum": 1,
          "description": "进程已启动但这么多秒没有任何 agent 侧活动证据 → 先探证据，仍无则中断重派"
        },
        "maxDispatchAttempts": {
          "type": "integer",
          "minimum": 1,
          "description": "同一张卡最多派几次（含首次）；用尽后向上开处置卡交给上级 agent"
        },
        "heartbeatGraceSec": {
          "type": "integer",
          "minimum": 30,
          "description": "adapter 的 run-heartbeat.json 多新才算「这一趟还在轮询」；新鲜时不重派（2026-11-19 心跳续命）"
        },
        "seatBudgetSlackSec": {
          "type": "integer",
          "minimum": 0,
          "description": "席位自己承诺的 maxMinutes 到了之后再宽限多久；仍无产出则直接收掉并向上收束，不再重派"
        },
        "noProgressAlertMinutes": {
          "type": "integer",
          "minimum": 0,
          "description": "心跳在、但产出心跳（run-progress.json）过期超过这么多分钟 → 报一次董事会提醒（不打断）；0 = 关闭"
        },
        "noProgressStopMinutes": {
          "type": "integer",
          "minimum": 0,
          "description": "再久这么多分钟仍零产出 → 判疑似中途等人：收掉这一趟、卡置「等人配合」，不再等满 60 分钟；0 = 关闭"
        }
      }
    },
    "repos": {
      "type": "object",
      "description": "仓库台账：代码在哪、往哪推、谁审。与项目解耦，两边都可以缺省。",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "displayName": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "remote": {
            "type": [
              "string",
              "null"
            ]
          },
          "branch": {
            "type": "string"
          },
          "reviewer": {
            "type": [
              "string",
              "null"
            ]
          },
          "allowPush": {
            "type": "boolean"
          },
          "project": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "defaultReviewer": {
          "type": "string"
        },
        "routineReviewer": {
          "type": [
            "string",
            "null"
          ],
          "description": "日常循环任务（巡检/体检/清理/简报）的默认审查人，默认工程岗。只有方向性任务才上升到总经理。"
        },
        "defaultHandoff": {
          "enum": [
            "byAssigner",
            "ceo",
            "land"
          ],
          "description": "认不出发布者时的兜底：byAssigner=按发布者推导（默认）、ceo=一律交总经理验收、land=一律直接落盘。"
        },
        "requireRepoForManagedCode": {
          "type": "boolean"
        },
        "codeExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selfWork": {
          "type": "object",
          "description": "「自己做还是派下去」的尺子：只作为提示词判据，不做硬拦截。超出范围必须派卡。",
          "properties": {
            "maxFiles": {
              "type": "integer",
              "minimum": 1,
              "description": "单点小改允许的文件数上限，默认 1。"
            },
            "maxLines": {
              "type": "integer",
              "minimum": 1,
              "description": "单点小改允许的改动行数上限，默认 40。"
            }
          }
        }
      }
    },
    "wake": {
      "type": "object",
      "additionalProperties": false,
      "description": "主动唤醒：卡排进「人叫才醒」的拉模式席位时，控制面往 WorkBuddy 会话投一条消息把它叫起来（走 CodeBuddy Gateway，不需要常驻进程、不需要外部 API key）。",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "关掉就退回「只提醒」：卡排队时消息区留一句，等人自己开口。"
        },
        "credsFiles": {
          "type": "array",
          "items": { "type": "string" },
          "description": "网关凭据文件（端口 + 密码，每个会话都不一样）。给了就只认这几个，不再回落到系统默认路径。"
        },
        "maxWaitMs": {
          "type": "integer",
          "minimum": 1000,
          "description": "会话正忙时最多等多久再补发唤醒，默认 10 分钟。"
        },
        "cooldownMs": {
          "type": "integer",
          "minimum": 0,
          "description": "同一张卡的唤醒冷却，避免打回重做时反复叫，默认 10 分钟。"
        }
      }
    }
  }
}