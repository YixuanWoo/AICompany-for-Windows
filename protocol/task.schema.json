{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aicompany.task/v1",
  "title": "TaskCard",
  "description": "任务卡。v1.0：字段用中性席位码，不出现任何产品名（任务书 §6.3 / §6C.2）。",
  "type": "object",
  "required": [
    "schema",
    "taskId",
    "requestId",
    "role",
    "assignee",
    "status",
    "createdAt",
    "instructions",
    "acceptance",
    "completionReportPath",
    "revision"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "aicompany.task/v1"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "parentTaskId": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string"
    },
    "project": {
      "type": [
        "string",
        "null"
      ],
      "description": "P7 项目 id；规范与记忆在 <workRoot>/projects/<id>/ 下。老卡为 null。"
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "卡间依赖：前置卡的 taskId。非空时前置没 done 就不派活。空数组 / 不写 = 并行（老行为）。"
    },
    "repo": {
      "type": [
        "string",
        "null"
      ],
      "description": "代码仓库 id（company.yaml 的 repos 段）。与 project 解耦：一张卡可以只有仓库没有项目。"
    },
    "reviewBy": {
      "type": [
        "string",
        "null"
      ],
      "description": "这张卡由谁验收（岗位 id）。不写 = 总经理验收；代码类活通常写工程岗。"
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "enum": [
        "delegate",
        "direct",
        "cowork",
        "meeting"
      ]
    },
    "addressedTo": {
      "type": [
        "string",
        "null"
      ]
    },
    "cc": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assignedBy": {
      "enum": [
        "human",
        "policy",
        "ceo",
        "seat",
        "control-plane"
      ]
    },
    "threadId": {
      "type": [
        "string",
        "null"
      ]
    },
    "assignee": {
      "type": "string",
      "minLength": 1
    },
    "reportsTo": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "backlog",
        "todo",
        "in_progress",
        "awaiting_decision",
        "in_review",
        "done",
        "cancelled",
        "blocked",
        "paused"
      ]
    },
    "priority": {
      "enum": [
        "low",
        "normal",
        "high"
      ]
    },
    "difficulty": {
      "enum": [
        "easy",
        "normal",
        "hard"
      ],
      "default": "normal"
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "lease": {
      "type": [
        "object",
        "null"
      ]
    },
    "budget": {
      "type": "object"
    },
    "input": {
      "type": "object"
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "completionReportPath": {
      "type": "string",
      "minLength": 1
    },
    "retry": {
      "type": "object"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "origin": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
