{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aicompany.change-request/v1",
  "title": "ChangeRequest",
  "description": "执行中的非终态变更请求。每次落盘触发事件，按 changeRequestId 去重（任务书 §6D.2）。",
  "type": "object",
  "required": ["schema", "changeRequestId", "taskId", "runId", "agentId", "reportsTo", "revision", "kind", "severity", "reason", "doneSoFar", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "aicompany.change-request/v1" },
    "changeRequestId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "agentId": { "type": "string", "minLength": 1 },
    "reportsTo": { "type": ["string", "null"] },
    "revision": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["direction", "clarify", "scope", "blocked"] },
    "severity": { "enum": ["needsDecision", "advisory"] },
    "reason": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "doneSoFar": { "type": "object" },
    "suggestedOptions": { "type": "array", "items": { "type": "object" } },
    "requestedDecisionBy": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "minLength": 1 }
  }
}
